# Copy to .env (never commit .env). All values are optional for local runs.
CTEM_HOST=127.0.0.1
CTEM_PORT=8080
CTEM_APP_ENV=lab
CTEM_LOG_LEVEL=INFO
# Random per process if unset. Set a stable value when running multiple workers.
CTEM_SECRET_KEY=
# Password for the seeded lab accounts "analyst" and "admin" (default: ctem-demo).
CTEM_DEMO_PASSWORD=
# Used after CTEM-SECRET-01 is remediated. Any dummy value works; nothing is called.
CTEM_INVENTORY_API_KEY=
CTEM_SECURE_COOKIES=false
